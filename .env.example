# --- Database backend ---
# Standalone (no server): SQLite. Leave DATABASE_URL/DB_NAME empty and set:
#   DB_BACKEND=sqlite
#   SQLITE_PATH=kirana.db          # relative to project; absolute paths work
#   # or: DATABASE_URL=sqlite:///kirana.db
# The schema + product catalog + admin/staff logins are created automatically
# on first launch. Remote Store Settings still use PostgreSQL URLs.
#
# PostgreSQL local (laptop / docker compose) or remote-managed: use DB_*
# below or DATABASE_URL and set:
#   DB_BACKEND=postgres
DB_BACKEND=sqlite
SQLITE_PATH=kirana.db

# Desktop bundle: writable data folder for the DB/logo/secret key.
# Defaults to %LOCALAPPDATA%\KiranaPro (Windows) or ~/.local/share/kiranapro.
#KIRANA_DATA_DIR=

# Copy to .env and fill in your values:  cp .env.example .env
# .env holds secrets — never commit it.

# --- PostgreSQL: pick ONE mode ---
#
# LOCAL Postgres (laptop / docker compose):
#   Leave DATABASE_URL empty and fill in DB_* below (DB_HOST=localhost
#   without Docker, or `docker compose up --build` which wires DB_HOST=db
#   for you). Keep DB_SSLMODE empty — plain local Postgres has no TLS.
#
# REMOTE managed Postgres (Neon, Supabase, RDS, Render, ...):
#   Set DATABASE_URL to the provider's connection string AND set
#   DB_SSLMODE=require (enforced even if the URL has no ?sslmode= param).
#   DATABASE_URL takes precedence over DB_* everywhere
#   (app.py + seed.py + backup/restore via pg_dump/psql).
#     DATABASE_URL=postgresql://user:password@host:5432/dbname
#     DB_SSLMODE=require
#
# Mode B — split vars against a REMOTE host also works: set
# DB_HOST to the remote hostname + DB_SSLMODE=require.
#
DB_NAME=kiranapro
DB_USER=kiranapro
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432
# Leave empty to use Mode B. Set it to use Mode A:
DATABASE_URL=
# TLS for Postgres: empty (local) or require (most managed providers).
DB_SSLMODE=

# --- Application ---
# Shown on the login screen, sidebar and /api/health.
APP_VERSION=1.0.0
APP_LICENSE=GPL-3.0
DEVELOPER_NAME="Vipul Verulkar"
DEVELOPER_CONTACT=vipulverulkar@gmail.com
DEVELOPER_LOCATION=India

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=1
PORT=5000

# --- Store (first-run fallbacks — Settings menu in the app owns these afterwards) ---
# Name/location/address/phone/footer + billing/loyalty/inventory defaults are
# persisted in the store_settings table via PUT /api/settings (admin).
# These env values only seed blanks on first run; later edits happen in the UI.
STORE_NAME="KiranaPro"
STORE_LOCATION="Mumbai, Maharashtra"
STORE_ADDRESS="123 MG Road, Mumbai, Maharashtra 400001"
STORE_PHONE="9876543210"
# Optional logo image URL (e.g. https://.../logo.png). If empty, the logo
# uploaded via Store Settings in the app is used instead.
STORE_LOGO=""

# --- Security (set to 1 when serving over HTTPS) ---
COOKIE_SECURE=0

# --- Demo seed logins (used by `python seed.py` only; change for real installs) ---
#SEED_ADMIN_USER=admin
#SEED_ADMIN_PASSWORD=change-me-admin
#SEED_STAFF_USER=staff
#SEED_STAFF_PASSWORD=change-me-staff
